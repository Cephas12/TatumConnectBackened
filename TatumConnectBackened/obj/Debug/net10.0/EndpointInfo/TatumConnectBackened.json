          "IT",
          "Electricity",
          "CableTv",
          "Internet",
          "Betting",
          "Education",
          "Transport",
          "Insurance",
          "Government",
          "Other"
        ],
        "type": "string"
      },
      "BillerDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
